generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String
  email           String           @unique
  phone           String           @unique
  passwordHash    String
  role            Role             @default(USER)
  isEmailVerified Boolean          @default(false)
  emailVerifiedAt DateTime?
  avatarUrl       String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  auditLogs       AuditLog[]       @relation("AuditActor")
  bookings        Booking[]
  contactReplies  ContactMessage[] @relation("RepliedBy")
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  reviews         Review[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userAgent String?
  ipAddress String?
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Kart {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  status        KartStatus    @default(AVAILABLE)
  lastServiceAt DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bookingKarts  BookingKart[]

  @@map("karts")
}

model PricingPackage {
  id           String    @id @default(uuid())
  name         String
  durationMins Int
  basePrice    Decimal   @db.Decimal(10, 2)
  isGroup      Boolean   @default(false)
  maxKarts     Int       @default(1)
  description  String?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]

  @@map("pricing_packages")
}

model Coupon {
  id         String     @id @default(uuid())
  code       String     @unique
  type       CouponType
  value      Decimal    @db.Decimal(10, 2)
  maxUses    Int?
  usedCount  Int        @default(0)
  validFrom  DateTime?
  validUntil DateTime?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  bookings   Booking[]

  @@map("coupons")
}

model Booking {
  id             String         @id @default(uuid())
  bookingRef     String         @unique
  date           DateTime       @db.Date
  startTime      String
  durationMins   Int
  kartsCount     Int
  specialNotes   String?
  status         BookingStatus  @default(PENDING)
  paymentMethod  PaymentMethod  @default(CASH)
  paymentStatus  PaymentStatus  @default(UNPAID)
  totalPrice     Decimal        @db.Decimal(10, 2)
  discountAmount Decimal        @default(0) @db.Decimal(10, 2)
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userId         String
  packageId      String
  couponId       String?
  karts          BookingKart[]
  coupon         Coupon?        @relation(fields: [couponId], references: [id])
  package        PricingPackage @relation(fields: [packageId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  review         Review?

  @@index([date, startTime])
  @@index([userId])
  @@map("bookings")
}

model BookingKart {
  id        String  @id @default(uuid())
  riderName String?
  bookingId String
  kartId    String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kart      Kart    @relation(fields: [kartId], references: [id])

  @@unique([bookingId, kartId])
  @@map("booking_karts")
}

model Review {
  id           String       @id @default(uuid())
  rating       Int
  comment      String
  status       ReviewStatus @default(PENDING)
  rejectReason String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  userId       String
  bookingId    String?      @unique
  booking      Booking?     @relation(fields: [bookingId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model ContactMessage {
  id          String        @id @default(uuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  status      MessageStatus @default(OPEN)
  replyText   String?
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  repliedById String?
  repliedBy   User?         @relation("RepliedBy", fields: [repliedById], references: [id])

  @@map("contact_messages")
}

model BusinessHour {
  id        String   @id @default(uuid())
  day       WeekDay  @unique
  isOpen    Boolean  @default(true)
  openTime  String   @default("10:00")
  closeTime String   @default("22:00")
  updatedAt DateTime @updatedAt

  @@map("business_hours")
}

model BlockedDate {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  reason    String?
  wholeDay  Boolean  @default(true)
  startTime String?
  endTime   String?
  createdAt DateTime @default(now())

  @@unique([date, startTime, endTime])
  @@map("blocked_dates")
}

model TrackStatus {
  id                String                 @id @default(uuid())
  operationalStatus TrackOperationalStatus @default(OPEN)
  customMessage     String?
  overrideActive    Boolean                @default(false)
  scheduledReopenAt DateTime?
  updatedAt         DateTime               @updatedAt
  updatedById       String?

  @@map("track_status")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SiteSettings {
  id           String   @id @default(uuid())
  businessName String   @default("GKarting")
  logoUrl      String?
  phone        String?
  email        String?
  whatsapp     String?
  instagramUrl String?
  facebookUrl  String?
  address      String?
  latitude     Float?
  longitude    Float?
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  WISH_MONEY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  COMING_SOON
}

enum KartStatus {
  AVAILABLE
  RESERVED
  MAINTENANCE
  BROKEN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageStatus {
  OPEN
  REPLIED
  ARCHIVED
}

enum TrackOperationalStatus {
  OPEN
  CLOSED
  MAINTENANCE
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  REVIEW_APPROVED
  REVIEW_REJECTED
  SYSTEM
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
