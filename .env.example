# ============================================================
# APP
# ============================================================
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# ============================================================
# DATABASE (PostgreSQL via Prisma)
# ============================================================
DATABASE_URL="postgresql://gkarting:gkarting_password@localhost:5432/gkarting?schema=public"

# ============================================================
# JWT AUTH
# ============================================================
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFY_SECRET=change_this_email_verify_secret
JWT_EMAIL_VERIFY_EXPIRES_IN=1d
JWT_RESET_PASSWORD_SECRET=change_this_reset_password_secret
JWT_RESET_PASSWORD_EXPIRES_IN=1h

# ============================================================
# BCRYPT
# ============================================================
BCRYPT_SALT_ROUNDS=12

# ============================================================
# NODEMAILER (SMTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASSWORD=your_smtp_app_password
MAIL_FROM_NAME=GKarting
MAIL_FROM_ADDRESS=race@gkarting.com

# ============================================================
# CLOUDINARY (image uploads: gallery, karts, avatars)
# ============================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================
# GOOGLE MAPS
# ============================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
TRACK_LATITUDE=34.4361
TRACK_LONGITUDE=35.8497

# ============================================================
# WEATHER (OpenWeatherMap)
# ============================================================
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ============================================================
# THROTTLING
# ============================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================================
# SUPER ADMIN SEED (used only by prisma/seed.ts)
# ============================================================
SEED_ADMIN_EMAIL=admin@gkarting.com
SEED_ADMIN_PASSWORD=ChangeMe123!
